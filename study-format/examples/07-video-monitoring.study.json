{
  "$schema": "../elicit_study/contracts/study.schema.json",
  "schema_version": "1",
  "key": "video-monitoring",
  "title": "Video timing and input monitoring",
  "description": "Offline rewrite of a client-api example; see README.md for migration scope.",
  "settings": {
    "allow_anonymous": true
  },
  "assets": [
    {
      "key": "clip",
      "kind": "video",
      "uri": "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4",
      "mime_type": "video/mp4"
    }
  ],
  "protocols": [
    {
      "key": "main",
      "phases": [
        {
          "key": "viewing",
          "trials": [
            {
              "key": "clip",
              "components": [
                {
                  "key": "monitor",
                  "type": "monitor",
                  "type_version": "1",
                  "config": {
                    "mouse": true,
                    "keyboard": true,
                    "max_rate_hz": 30
                  }
                },
                {
                  "key": "video",
                  "type": "media",
                  "type_version": "1",
                  "config": {
                    "asset": "clip",
                    "optional": false,
                    "pausable": false,
                    "replayable": true,
                    "max_replays": 2
                  }
                }
              ]
            },
            {
              "key": "response",
              "components": [
                {
                  "key": "comment",
                  "type": "free_text",
                  "type_version": "1",
                  "config": {
                    "prompt": "What did you notice?"
                  }
                }
              ]
            }
          ],
          "order": {
            "mode": "fixed",
            "sequence": [
              "clip",
              "response"
            ]
          }
        },
        {
          "key": "finish",
          "trials": [
            {
              "key": "thanks",
              "components": [
                {
                  "key": "end",
                  "type": "end",
                  "type_version": "1",
                  "config": {}
                }
              ]
            }
          ],
          "order": {
            "mode": "fixed",
            "sequence": [
              "thanks"
            ]
          }
        }
      ],
      "phase_order": [
        "viewing",
        "finish"
      ]
    }
  ]
}
