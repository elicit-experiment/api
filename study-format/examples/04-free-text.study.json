{
  "$schema": "../elicit_study/contracts/study.schema.json",
  "schema_version": "1",
  "key": "free-text",
  "title": "Free text and validation",
  "description": "Offline rewrite of a client-api example; see README.md for migration scope.",
  "settings": {
    "allow_anonymous": true
  },
  "assets": [],
  "protocols": [
    {
      "key": "main",
      "phases": [
        {
          "key": "questions",
          "trials": [
            {
              "key": "comment",
              "components": [
                {
                  "key": "comment",
                  "type": "free_text",
                  "type_version": "1",
                  "config": {
                    "prompt": "Your comments",
                    "rows": 5,
                    "max_length": 1000
                  }
                }
              ]
            },
            {
              "key": "ones",
              "components": [
                {
                  "key": "ones",
                  "type": "free_text",
                  "type_version": "1",
                  "config": {
                    "prompt": "Enter only 1s",
                    "validation_pattern": "^1+$",
                    "rows": 1
                  }
                }
              ]
            },
            {
              "key": "optional",
              "components": [
                {
                  "key": "comment",
                  "type": "free_text",
                  "type_version": "1",
                  "config": {
                    "prompt": "Anything else?",
                    "required": false
                  }
                }
              ]
            }
          ],
          "order": {
            "mode": "fixed",
            "sequence": [
              "comment",
              "ones",
              "optional"
            ]
          }
        },
        {
          "key": "finish",
          "trials": [
            {
              "key": "thanks",
              "components": [
                {
                  "key": "end",
                  "type": "end",
                  "type_version": "1",
                  "config": {}
                }
              ]
            }
          ],
          "order": {
            "mode": "fixed",
            "sequence": [
              "thanks"
            ]
          }
        }
      ],
      "phase_order": [
        "questions",
        "finish"
      ]
    }
  ]
}
