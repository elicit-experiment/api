{
  "$schema": "../elicit_study/contracts/study.schema.json",
  "schema_version": "1",
  "key": "scale",
  "title": "Continuous scale",
  "description": "Offline rewrite of a client-api example; see README.md for migration scope.",
  "settings": {
    "allow_anonymous": true
  },
  "assets": [],
  "protocols": [
    {
      "key": "main",
      "phases": [
        {
          "key": "ratings",
          "trials": [
            {
              "key": "position",
              "components": [
                {
                  "key": "scale",
                  "type": "scale_1d",
                  "type_version": "1",
                  "config": {
                    "prompt": "Choose a position",
                    "min": -1,
                    "max": 1,
                    "ticks": [
                      {
                        "value": -1,
                        "label": "Low"
                      },
                      {
                        "value": 0,
                        "label": "Neutral"
                      },
                      {
                        "value": 1,
                        "label": "High"
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "order": {
            "mode": "fixed",
            "sequence": [
              "position"
            ]
          }
        },
        {
          "key": "finish",
          "trials": [
            {
              "key": "thanks",
              "components": [
                {
                  "key": "end",
                  "type": "end",
                  "type_version": "1",
                  "config": {}
                }
              ]
            }
          ],
          "order": {
            "mode": "fixed",
            "sequence": [
              "thanks"
            ]
          }
        }
      ],
      "phase_order": [
        "ratings",
        "finish"
      ]
    }
  ]
}
